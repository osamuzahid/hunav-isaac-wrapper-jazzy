# ROS2 build files
/build/
/install/
/log/   
# Python cache files
__pycache__/
*.pyc       
# IDE specific files
.vscode/
.idea/
*.iml
# Temporary files   
*.tmp
*.swp
*~
# Runtime launcher state (written by main.py)
src/config/last_launch_config.json
**/last_launch_config.json

# Local-only hospital backups / superseded stock-hospital artifacts (keep on disk, never commit)
src/worlds/hospital.usd.bak_*
src/worlds/hospital.usd.cdn_compose_WRONG
src/maps/hospital_isaac_stock.*
src/worlds/office.usd.bak_*
src/maps/office_isaac_stock.*
src/scenarios/office_agents_isaac_stock.yaml
src/config/robots/stretch/payloads/base.usda.bak_instanceable
tools/remap_hospital_isaac60_assets.py

# Reachy: baked OBJs (assimp -ptv) — regenerate with tools/bake_reachy_meshes.sh
src/config/robots/reachy/meshes/*.obj
src/config/robots/reachy/meshes/*.mtl
